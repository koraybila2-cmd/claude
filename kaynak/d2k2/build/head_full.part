<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>__TITLE__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
<style>
  :root {
    --color-bg: #f3f2f2;
    --color-text: #201e1d;
    --color-accent: #0088b0;
    --color-accent-700: color-mix(in oklch, #0088b0, black 35%);
    --color-accent-900: color-mix(in oklch, #0088b0, black 55%);
    --color-accent-2: #d6006c;
    --color-accent-2-900: color-mix(in oklch, #d6006c, black 45%);
    --color-neutral-700: #57534e;
    --font-heading: "Source Serif 4", Georgia, "Times New Roman", serif;
    --font-body: "Source Serif 4", Georgia, "Times New Roman", serif;
  }
  @page { size: A4; margin: 24mm 20mm 24mm 20mm; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); }
  a { color: var(--color-accent-700); }
  .book-page { max-width: 100%; }
  .book-kicker { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-700); margin: 0 0 16px 0; }
  .book-title { font-family: var(--font-heading); font-size: 2.3rem; line-height: 1.15; font-weight: 700; margin: 0 0 12px 0; }
  .book-byline { font-style: italic; color: var(--color-neutral-700); font-size: 0.92rem; margin: 0 0 40px 0; }
  .book-section { margin: 0 0 24px 0; }
  .book-h2 { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; margin: 0 0 12px 0; break-after: avoid; }
  .book-h3 { font-family: var(--font-heading); font-size: 1.08rem; font-weight: 700; margin: 18px 0 8px 0; break-after: avoid; }
  .book-p { font-size: 0.94rem; line-height: 1.56; margin: 0 0 12px 0; text-align: justify; hyphens: auto; }
  .book-list { font-size: 0.94rem; line-height: 1.56; margin: 0 0 10px 0; padding-left: 1.3em; }
  .book-list li { margin-bottom: 4px; }
  .tag { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 2px; }
  .tag-accent-2 { background: color-mix(in oklch, var(--color-accent-2) 14%, white); color: var(--color-accent-2-900); }
  .highlight-tag { margin-bottom: 8px; break-inside: avoid; }
  .highlight-p { font-size: 0.92rem; line-height: 1.55; color: var(--color-accent-2-900); margin: 0 0 12px 0; break-inside: avoid; }
  .cite { font-style: italic; color: var(--color-neutral-700); }
  table.table { width: 100%; border-collapse: collapse; font-size: 0.86rem; margin: 4px 0 16px 0; break-inside: avoid; }
  table.table th { text-align: left; font-family: var(--font-heading); font-weight: 700; border-bottom: 1.5px solid var(--color-text); padding: 6px 10px 6px 0; }
  table.table td { border-bottom: 1px solid color-mix(in oklch, var(--color-text) 15%, white); padding: 7px 10px 7px 0; vertical-align: top; }
  .chart-figure { margin: 4px 0 12px 0; break-inside: avoid; }
  .chart-caption { font-size: 0.82rem; color: var(--color-neutral-700); margin-top: 8px; font-style: italic; text-align: left; }
  .qa-list { display: flex; flex-direction: column; gap: 14px; margin-top: 14px; }
  .card { background: white; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.09); padding: 13px 18px; break-inside: avoid; }
  .card-kicker { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700); margin-bottom: 4px; }
  .card-title { font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; }
  .card-body { font-size: 0.89rem; line-height: 1.52; }
  .card-body p { margin: 0 0 8px 0; }
  .card-body .opt-correct { color: var(--color-accent-700); font-weight: 700; }
  .card-source { font-size: 0.8rem; font-style: italic; color: var(--color-neutral-700); margin-top: 8px; }
  .card-dispute { font-size: 0.85rem; background: color-mix(in oklch, var(--color-accent-2) 8%, white); padding: 8px 12px; border-radius: 2px; margin-top: 8px; }
  .chapter { break-before: page; }
  .chapter-first { break-before: auto; }
  .chapter-kicker { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-700); margin: 0 0 6px 0; }
  .chapter-title { font-family: var(--font-heading); font-size: 1.75rem; line-height: 1.2; font-weight: 700; margin: 0 0 8px 0; break-after: avoid; }
  .chapter-lead { font-style: italic; color: var(--color-neutral-700); font-size: 0.95rem; line-height: 1.6; margin: 0 0 26px 0; }
  .book-h4 { font-family: var(--font-heading); font-size: 0.98rem; font-weight: 700; font-style: italic; margin: 14px 0 6px 0; break-after: avoid; }
  ol.book-list { padding-left: 1.5em; }
  .toc { list-style: none; padding: 0; margin: 0 0 12px 0; font-size: 0.98rem; line-height: 1.7; }
  .toc li { margin: 0 0 4px 0; }
  .toc .toc-sub { color: var(--color-neutral-700); font-size: 0.88rem; display: block; margin-left: 1.2em; }
  .cover-note { font-size: 0.92rem; line-height: 1.6; color: var(--color-neutral-700); margin: 0 0 14px 0; }
  .keybox { background: white; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.09); padding: 14px 18px; margin: 6px 0 16px 0; break-inside: avoid; }
  .keybox-title { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700); margin-bottom: 6px; font-weight: 700; }
  .keybox ul { margin: 0; padding-left: 1.2em; font-size: 0.92rem; line-height: 1.6; }
  .keybox li { margin-bottom: 3px; }
  .card-title .opts { display: block; font-weight: 400; font-family: var(--font-body); font-size: 0.89rem; margin-top: 6px; line-height: 1.55; }
  table.table.compact { font-size: 0.78rem; } table.table.compact td { padding: 5px 8px 5px 0; }
  sub, sup { line-height: 0; }
  @page { size: A4; margin: 22mm 20mm 20mm 20mm; background: #f3f2f2; }
  .hl-block { break-inside: avoid; }
  .card { break-inside: auto; }
  .card-kicker, .card-title { break-after: avoid; }
  .card-body p { orphans: 3; widows: 3; }
  .chart-figure svg { max-width: 86%; margin: 0 auto; }
  .chart-figure.wide svg { max-width: 100%; }
  table.table.split { break-inside: auto; }
  table.table.split tr { break-inside: avoid; }
</style>
</head>
<body>
<main class="book-page">
